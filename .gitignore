# ==========================================

node_modules/
frontend/node_modules/
application/*.ui

# Vite
frontend/dist/
frontend/.vite/

# Build outputs
frontend/build/

# Environment variables frontend
frontend/.env
frontend/.env.*
!frontend/.env.example

# ==========================================
# TypeScript
# ==========================================

*.tsbuildinfo

