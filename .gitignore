# ==========================================
# Go
# ==========================================

# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Build output
/bin/
/build/
/dist/

# Go coverage
coverage.out
coverage.html
*.coverprofile

# Go workspace
go.work
go.work.sum

# ==========================================
# Environment variables / secrets
# ==========================================

.env
.env.*
!.env.example

# ==========================================
# Database
# ==========================================

# SQLite
*.sqlite
*.sqlite3
*.db

# PostgreSQL dumps
*.sql
*.dump
*.backup

# Allow migration files
!migrations/*.sql

# ==========================================
# Logs
# ==========================================

*.log
logs/

# ==========================================
